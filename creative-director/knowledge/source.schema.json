{
  "type": "object",
  "required": [
    "id",
    "title",
    "url",
    "version",
    "reviewed_on",
    "status",
    "sensitivity",
    "claims",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "reviewed",
        "partial",
        "unresolved"
      ]
    },
    "sensitivity": {
      "enum": [
        "stable",
        "living",
        "version-sensitive"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creative Director source"
}
