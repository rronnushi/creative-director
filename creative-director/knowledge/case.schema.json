{
  "type": "object",
  "required": [
    "id",
    "context",
    "objectives",
    "accepted_decisions",
    "rejected_decisions",
    "constraints",
    "reasoning",
    "implementation_lessons",
    "generalizable_principles",
    "exceptions",
