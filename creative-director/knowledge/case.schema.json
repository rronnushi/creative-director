    "evidence_locations",
    "limitations",
    "public_release"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accepted_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rejected_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "implementation_lessons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generalizable_principles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_level": {
      "enum": [
        "explicit-feedback",
        "documentation-observation",
        "inferred",
        "synthetic"
      ]
    },
    "evidence_locations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "public_release": {
      "type": "boolean"
    }
